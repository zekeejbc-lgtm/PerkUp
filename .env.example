# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase details
VITE_SUPABASE_URL="https://fstwqgnonsqcqewiipqq.supabase.co"
VITE_SUPABASE_ANON_KEY=""

# Supabase Edge Function secrets. These are server-side only; do not expose the service role key with a VITE_ prefix.
SUPABASE_URL="https://fstwqgnonsqcqewiipqq.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY="PASTE_SUPABASE_SERVICE_ROLE_KEY_HERE"

# Demo login backend. Keep enabled only for demo/staging environments.
# Both flags must be explicitly true to expose the UI and enable the backend.
VITE_DEMO_LOGIN_ENABLED="false"
DEMO_LOGIN_ENABLED="false"
DEMO_LOGIN_ADMIN_SECRET="CHANGE_ME_TO_A_RANDOM_DEMO_CLEANUP_SECRET"

# Google Apps Script web app used for Google Drive image uploads.
VITE_GOOGLE_DRIVE_UPLOAD_URL="https://script.google.com/macros/s/AKfycbxfacR_tG28iu-riTquHZK9fRHN1aRAswJNUXAdRD36dd-YlxoqskAzQkgQvm1BWUQ/exec"
VITE_GAS_EMAIL_URL="https://script.google.com/macros/s/AKfycbxfacR_tG28iu-riTquHZK9fRHN1aRAswJNUXAdRD36dd-YlxoqskAzQkgQvm1BWUQ/exec"
GOOGLE_DRIVE_UPLOAD_URL="https://script.google.com/macros/s/AKfycbxfacR_tG28iu-riTquHZK9fRHN1aRAswJNUXAdRD36dd-YlxoqskAzQkgQvm1BWUQ/exec"
GAS_EMAIL_URL="https://script.google.com/macros/s/AKfycbxfacR_tG28iu-riTquHZK9fRHN1aRAswJNUXAdRD36dd-YlxoqskAzQkgQvm1BWUQ/exec"

# Google Apps Script Script Property for protected Drive CRUD actions.
# Use the same value in Vercel only for server-side code; do not expose this with a VITE_ prefix.
DRIVE_CRUD_SECRET="CHANGE_ME_TO_A_RANDOM_SECRET"

# Local Vite development.
DISABLE_HMR="false"
